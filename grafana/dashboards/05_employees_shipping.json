          "rawSql": "SELECT e.employee_alternate_key AS \"Employee ID\", concat(e.first_name, ' ', e.last_name) AS Employee, coalesce(e.title, '') AS Title, uniqExact(f.order_id) AS Orders, sum(f.quantity) AS Units, round(sum(toFloat64(f.unit_price) * toFloat64(f.quantity) * (1 - toFloat64(f.discount))), 2) AS Revenue, round(avgIf(dateDiff('day', f.order_date, f.shipped_date), f.order_date IS NOT NULL AND f.shipped_date IS NOT NULL), 2) AS \"Avg Shipping Days\" FROM (SELECT * FROM fact_orders FINAL WHERE is_deleted = 0) AS f INNER JOIN (SELECT * FROM dim_employee FINAL WHERE is_current = 1) AS e ON e.employee_key = f.employee_key GROUP BY \"Employee ID\", Employee, Title ORDER BY Revenue DESC",
