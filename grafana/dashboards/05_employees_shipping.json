          "format": 1,
          "pluginVersion": "4.21.1",
          "queryType": "table",
          "rawSql": "SELECT concat(e.first_name, ' ', e.last_name) AS Employee, round(sum(toFloat64(f.unit_price) * toFloat64(f.quantity) * (1 - toFloat64(f.discount))), 2) AS Revenue FROM (SELECT * FROM fact_orders FINAL WHERE is_deleted = 0) AS f INNER JOIN (SELECT * FROM dim_employee FINAL WHERE is_current = 1) AS e ON e.employee_key = f.employee_key GROUP BY Employee ORDER BY Revenue DESC",
