          "rawSql": "SELECT multiIf(Revenue >= 50000, 'VIP', Revenue >= 20000, 'High Value', Revenue >= 5000, 'Medium Value', 'Standard') AS Segment, count() AS Customers FROM (SELECT customer_key, sum(toFloat64(unit_price) * toFloat64(quantity) * (1 - toFloat64(discount))) AS Revenue FROM (SELECT * FROM fact_orders FINAL WHERE is_deleted = 0) WHERE customer_key != 0 GROUP BY customer_key) GROUP BY Segment ORDER BY Customers DESC",
