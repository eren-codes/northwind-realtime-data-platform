          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.21.1",
          "queryType": "table",
          "rawSql": "SELECT c.customer_alternate_key AS \"Customer ID\", c.company_name AS Customer, coalesce(g.country, 'Unknown') AS Country, uniqExact(f.order_id) AS Orders, sum(f.quantity) AS Units, round(sum(toFloat64(f.unit_price) * toFloat64(f.quantity) * (1 - toFloat64(f.discount))), 2) AS Revenue, max(f.order_date) AS \"Last Order\" FROM (SELECT * FROM fact_orders FINAL WHERE is_deleted = 0) AS f INNER JOIN (SELECT * FROM dim_customer FINAL WHERE is_current = 1) AS c ON c.customer_key = f.customer_key LEFT JOIN (SELECT * FROM dim_geography FINAL) AS g ON g.geography_key = c.geography_key GROUP BY \"Customer ID\", Customer, Country ORDER BY Revenue DESC",
